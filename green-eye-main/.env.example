# Optional: where the chatbot API lives. Defaults to "/chatbot-api" (proxied by Vite to http://localhost:5000).
# VITE_CHATBOT_API_URL=/chatbot-api
# Dev proxy target if the Flask backend runs elsewhere:
# CHATBOT_BACKEND_URL=http://localhost:5000

# --- Feature flags / display only (no secrets) ---
# Set to "true" once you've deployed the ESP32 sketch (esp32/pump_controller.ino)
# and configured ESP32_BASE_URL as a Supabase Edge Function secret — this only
# controls the "ESP32: Connected/Not Configured" label on the Plant Status card.
VITE_ESP32_CONFIGURED=false

# --- Supabase Edge Function secrets (set these via `supabase secrets set`, NOT here) ---
# ESP32_BASE_URL       e.g. http://192.168.1.50 — the ESP32's local IP running pump_controller.ino.
#                      If unset, the iot-treatment function runs in "simulated" mode (no hardware needed).
# WEATHER_API_KEY      Optional — only needed if you swap weather-data's default provider
#                      (Open-Meteo + BigDataCloud, both free/keyless) for a keyed one like OpenWeatherMap.
