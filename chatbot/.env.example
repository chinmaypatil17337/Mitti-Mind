# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=true

# LLM / STT / TTS — all via OpenAI
OPENAI_API_KEY=sk-...

# Chat model (also used for image analysis since gpt-4o-mini is multimodal)
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Speech-to-text (OpenAI Whisper)
STT_PROVIDER=openai
STT_MODEL=whisper-1

# Text-to-speech (OpenAI TTS)
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
# One of: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar
VOICE=alloy

# Redis (conversation memory)
REDIS_HOST=localhost
REDIS_PORT=6379
USERNAME=
PASSWORD=
REDIS_SSL=false
REDIS_SESSION_TTL=3600

LOG_LEVEL=INFO
